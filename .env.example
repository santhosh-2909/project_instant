# ---------------------------------------------------------------------------
# VeritasGuard environment
#
# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Any PostgreSQL instance. `directUrl` is used by Prisma migrations and may be
# the same value unless you are behind a connection pooler.
DATABASE_URL="postgresql://user:password@localhost:5432/veritasguard"
DIRECT_URL="postgresql://user:password@localhost:5432/veritasguard"

# --- Session signing (required) --------------------------------------------
# Minimum 32 characters. The app refuses to start with a weak or missing value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# --- Evidence providers (strongly recommended) ------------------------------
# Without at least one of these, every verdict falls back to language analysis
# alone and will correctly report as "Uncertain".

# Google Fact Check Tools API — the highest-value source. A hit means a
# professional fact-checker has already ruled on the claim.
# https://developers.google.com/fact-check/tools/api
GOOGLE_FACT_CHECK_API_KEY=""

# NewsAPI — independent corroboration from news archives.
# https://newsapi.org
NEWS_API_KEY=""

# --- Reasoning layer (optional) --------------------------------------------
# Weighted at only 8% of the decision and constrained to the retrieved
# passages. The pipeline works without it.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Reserved for future use by the article-verification path.
GEMINI_API_KEY=""
